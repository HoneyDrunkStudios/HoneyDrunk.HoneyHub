<?xml version="1.0" encoding="utf-8"?>
<!--
  The HoneyHub SB explorer helper depends only on the public Azure SDK packages. Clear any
  inherited (private / authenticated) feeds and restore straight from nuget.org so the helper
  builds standalone on any machine without org-feed credentials.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
