{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoneyHub",
  "version": "0.23.0",
  "identifier": "com.honeydrunkstudios.honeyhub",
  "build": {
    "frontendDist": "../../packages/ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HoneyDrunkStudios/HoneyDrunk.HoneyHub/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
